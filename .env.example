# The current storefront/admin UI does not require an API key.
# If an AI feature is added later, call it through a backend so its key is not
# exposed in browser JavaScript.
GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="http://localhost:3000"

# Never add MySQL passwords, session secrets, bootstrap-owner passwords,
# payment credentials or storage secret keys to Vite/browser environment files.
# See docs/INSTALLATION_AND_DEPLOYMENT.md for server-only settings.
